<?xml version="1.0" encoding="utf-8"?>
<!-- migrate MaterialComponents to Material3 -->
<resources>

    <!-- Labels may wrap to two lines at large font scales (WCAG 1.4.4) and ellipsize after. -->
    <style name="TextAppearance.OpenTracks.PrimaryHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.SecondaryHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.HiddenHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.PrimaryValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.SecondaryValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.HiddenValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.PrimaryUnit" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
      Recording screen "instrument plate". Kept separate from the styles above, which the
      recorded/recap/share screens also use: those screens are not part of this redesign.
      Ink for numerals, muted ink for labels, size encodes rank, digits are tabular so values
      do not shift horizontally while ticking.
    -->

    <style name="TextAppearance.OpenTracks.HeroValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">56sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterDetail" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Unit in the fixed gutter right of the numeral, so units align down a column. -->
    <style name="TextAppearance.OpenTracks.RegisterUnit" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Quiet tab labels: state comes from the 3dp indicator, never from coloured text. -->
    <style name="TextAppearance.OpenTracks.TabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Status strip: only shown when recording state or GPS is not nominal. -->
    <style name="TextAppearance.OpenTracks.StatusStrip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Home log row: mono stats line, muted context line. -->
    <style name="TextAppearance.OpenTracks.RowStats" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.RowContext" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
      "Track at dusk" home scale. Inter speaks, JetBrains Mono measures. The score value is the
      one number the eye lands on; lane labels are tracked, never used as kickers above a heading.
    -->
    <style name="TextAppearance.OpenTracks.ScoreValue" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">48sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Fixed light ink for the asphalt route hero, independent of the day/night theme. -->
    <style name="TextAppearance.OpenTracks.HeroScore" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">@color/hero_ink</item>
        <item name="android:textSize">64sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">32sp</item>
        <item name="android:autoSizeMaxTextSize">64sp</item>
        <item name="android:autoSizeStepGranularity">2sp</item>
    </style>

    <style name="TextAppearance.OpenTracks.HeroLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/waykeep_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.HeroMeta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/hero_ink_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.LaneLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.MetaValue" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.RowDistance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">26sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.RowDate" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Aggregated-stats and share screens use the Primary/Secondary families above. -->
</resources>
