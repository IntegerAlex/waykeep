<?xml version="1.0" encoding="utf-8"?>
<!-- migrate MaterialComponents to Material3 -->
<resources>

    <style name="TextAppearance.OpenTracks.PrimaryHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.SecondaryHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.HiddenHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.PrimaryValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.SecondaryValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.HiddenValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TextAppearance.OpenTracks.PrimaryUnit" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
      Recording screen "instrument plate". Kept separate from the styles above, which the
      recorded/recap/share screens also use: those screens are not part of this redesign.
      Ink for numerals, muted ink for labels, size encodes rank, digits are tabular so values
      do not shift horizontally while ticking.
    -->

    <style name="TextAppearance.OpenTracks.HeroValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">56sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterValue" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.OpenTracks.RegisterDetail" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Unit in the fixed gutter right of the numeral, so units align down a column. -->
    <style name="TextAppearance.OpenTracks.RegisterUnit" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Quiet tab labels: state comes from the 2dp indicator, never from coloured text. -->
    <style name="TextAppearance.OpenTracks.TabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Status strip: only shown when recording state or GPS is not nominal. -->
    <style name="TextAppearance.OpenTracks.StatusStrip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Stat cell used by the activity feed cards -->
    <style name="TextAppearance.OpenTracks.StatValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.OpenTracks.StatLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
