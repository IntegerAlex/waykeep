<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/marker_sheet_photo"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="@string/marker_sheet_photo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/marker_sheet_name"
        style="?attr/textAppearanceHeadline6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/marker_sheet_type"
        style="@style/TextAppearance.OpenTracks.SecondaryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/marker_sheet_time"
        style="@style/TextAppearance.OpenTracks.SecondaryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/marker_sheet_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/marker_sheet_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/marker_sheet_open_details" />

</LinearLayout>
