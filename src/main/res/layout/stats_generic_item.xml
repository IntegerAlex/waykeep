<?xml version="1.0" encoding="utf-8"?>
<!--
  One register of the recording plate: label top-left, numeral bottom-right against a fixed
  unit gutter. The same layout serves the hero (56sp, full-width row) and the compact
  registers (24sp); the numeral style is applied by the view holder from DataField.isPrimary.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/stats_description_main"
        style="@style/TextAppearance.OpenTracks.RegisterLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/stats_distance" />

    <TextView
        android:id="@+id/stats_unit"
        style="@style/TextAppearance.OpenTracks.RegisterUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        app:layout_constraintWidth_min="36dp"
        app:layout_constraintBaseline_toBaselineOf="@id/stats_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/stats_value"
        tools:text="km" />

    <TextView
        android:id="@+id/stats_value"
        style="@style/TextAppearance.OpenTracks.RegisterValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:gravity="end"
        android:value="@string/value_unknown"
        app:layout_constraintEnd_toStartOf="@id/stats_unit"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stats_description_main"
        tools:text="4.82" />

    <TextView
        android:id="@+id/stats_description_secondary"
        style="@style/TextAppearance.OpenTracks.RegisterDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stats_value"
        tools:text="Polar H10"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
