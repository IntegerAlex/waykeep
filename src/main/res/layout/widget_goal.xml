<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher widget: RemoteViews only (no custom views, no ?attr colors — the launcher inflates this). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_goal_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.02"
        android:maxLines="2"
        android:singleLine="false"
        android:text="@string/widget_goal_scope"
        android:textAllCaps="false"
        android:textColor="#B3FFFFFF"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_goal_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- RemoteViews whitelist has no Space; an empty TextView does the same filler job. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/widget_goal_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="@color/waykeep_cyan" />

    <TextView
        android:id="@+id/widget_goal_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_goal_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
