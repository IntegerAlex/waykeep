<?xml version="1.0" encoding="utf-8"?><!--
Waykeep brand tokens for dark/OLED mode.
-->
<resources>
    <!-- Bright high-visibility cyan reads best against true black. -->
    <color name="waykeep_cyan">#00E5FF</color>
    <color name="waykeep_cyan_dim">#008B99</color>
    <color name="waykeep_cyan_transparent">#5500E5FF</color>
    <!-- On dark surfaces the accent role uses the bright cyan, not the dim one. -->
    <color name="waykeep_accent">@color/waykeep_cyan</color>
    <!-- Activity badge behind a themed glyph: dark on OLED, so the white icon stays visible. -->
    <color name="icon_badge_surface">#E61C1B1F</color>
</resources>
